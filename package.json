{
  "name": "prizculator",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "frontend": "node -r dotenv/config ./node_modules/.bin/vite dev --host",
    "backend": "cd backend &&node index.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "node -r dotenv/config ./node_modules/.bin/vite build",
    "preview": "node -r dotenv/config ./node_modules/.bin/vite preview",
    "prepare": "svelte-kit sync || echo ''"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "concurrently": "^10.0.7",
    "svelte": "^5.59.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@lucide/svelte": "^1.80.0",
    "@rusticstack/pico-reforged": "^2.0.1",
    "apexcharts": "^8.9.1",
    "dotenv": "^18.0.10",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3"
  }
}
